{"nodes": [{"id": "mdmpi_app_api_websockets_readme_websocket_endpoint", "label": "WebSocket Endpoint /api/ws", "file_type": "concept", "source_file": "MDMPI.App.Api/WebSockets/README.md", "source_location": "Connection instructions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production clients connect via wss://<host>/api/ws?apiKey=<key>; connections with a missing or invalid apiKey are rejected, and malformed JSON is logged as a warning without dropping the connection so the client can send the next valid message."}, {"id": "mdmpi_app_api_websockets_readme_api_key_auth", "label": "WebSocket API Key Authentication", "file_type": "rationale", "source_file": "MDMPI.App.Api/WebSockets/README.md", "source_location": "Configuration section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The production key is supplied via configuration (preferably the WebSocket__ApiKey environment-style setting) rather than hardcoded; missing or invalid keys cause connection rejection."}, {"id": "mdmpi_app_api_websockets_readme_location_update_payload", "label": "location_update Rider Payload", "file_type": "concept", "source_file": "MDMPI.App.Api/WebSockets/README.md", "source_location": "Manual verification step 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct rider payload with Type=location_update carrying RequestID, RiderId, Latitude/Longitude, Timestamp, Status, RiderInitial, ETA, Distance, and Client; the server rebroadcasts it wrapped as Message=Location and excludes the sender from its own broadcast."}, {"id": "mdmpi_app_api_websockets_readme_notification_payload", "label": "Notification Broadcast Payload", "file_type": "concept", "source_file": "MDMPI.App.Api/WebSockets/README.md", "source_location": "Manual verification step 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrapped Mes