{"nodes": [{"id": "_github_copilot_instructions_mdmpi_app_solution", "label": "MDMPI.App Solution", "file_type": "document", "source_file": ".github/copilot-instructions.md", "source_location": "Solution Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_copilot_instructions_clean_architecture", "label": "Clean Architecture Pattern", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "Architecture Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependency direction Api -> Core <- Data keeps Core free of references to Data or Api; Data implements interfaces defined in Core so business logic stays independent of infrastructure."}, {"id": "_github_copilot_instructions_mdmpi_app_api", "label": "MDMPI.App.Api Project", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "Solution Overview table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_copilot_instructions_mdmpi_app_core", "label": "MDMPI.App.Core Project", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "Solution Overview table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_copilot_instructions_mdmpi_app_data", "label": "MDMPI.App.Data Project", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "Solution Overview table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_copilot_instructions_mdmpi_app_common", "label": "MDMPI.App.Common Project", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "Solution Overview table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_copilot_instructions_mdmpi_app_tests", "label": "MDMPI.App.Tests Project", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "Solution Overview table / Testing", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_copilot_instructions_repository_pattern", "label": "Repository Pattern", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "Architecture Rules #2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data access is abstracted behind I*Repository interfaces in Core and implemented in Data, so services can be unit tested by mocking repositories via their interfaces."}, {"id": "_github_copilot_instructions_service_pattern", "label": "Service Pattern", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "Architecture Rules #3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business logic lives in Core/Services classes implementing I*Service interfaces, keeping controllers thin and logic testable."}, {"id": "_github_copilot_instructions_di_registration", "label": "Scoped DI Registration in Program.cs", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "Architecture Rules #4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All services and repositories are registered as Scoped in Program.cs unless there is an explicit reason for Singleton (e.g., ImageService)."}, {"id": "_github_copilot_instructions_appdbcontext", "label": "AppDbContext (EF Core)", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "Database and EF Core Guidelines", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Targets SQL Server via Microsoft.Data.SqlClient; UseSqlOutputClause(false) is required on tables with triggers."}, {"id": "_github_copilot_instructions_requestid_primary_key_rule", "label": "RequestID Primary Key Rule", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "Database and EF Core Guidelines", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use RequestID as primary key on Items and related tables; do not introduce a separate RequestItemID unless there is a documented need for item-level identity independent of the request. For multiple items per request use composite key (RequestID, ItemIndex) or a justified surrogate; schemas that already have RequestItemID should consolidate onto RequestID. ItemModel is an intentional exception that keeps RequestItemID as its primary key."}, {"id": "_github_copilot_instructions_itemmodel", "label": "ItemModel", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "Database and EF Core Guidelines", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ItemModel uses RequestItemID as its primary key \u2014 an intentional, documented exception to the RequestID primary key rule."}, {"id": "_github_copilot_instructions_id_generators", "label": "Custom ID Generators (Counter Tables)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "Database and EF Core Guidelines", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom ID generators (RequestIdGenerator, ItemIdGenerator, etc.) use counter tables; new generators must follow the existing pattern."}, {"id": "_github_copilot_instructions_naming_conventions", "label": "MDMPI.App Naming Conventions", "file_type": "document", "source_file": ".github/copilot-instructions.md", "source_location": "Naming Conventions table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_copilot_instructions_domain_folder_structure", "label": "Domain-First Folder Structure", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": "Folder Structure", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code is organized by domain area first (Common, Logistic, Collection) and then by concern, across Core, Data, and Api/Controllers."}, {"id": "_github_copilot_instructions_gemini_service", "label": "Gemini AI Integration (IGeminiService)", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "External Integrations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Configured via GeminiSettings bound from appsettings.json; accessed only through the IGeminiService interface."}, {"id": "_github_copilot_instructions_image_service", "label": "Image Upload Services (ImageService / IImageService)", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": "External Integrations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Image uploads are handled by ImageService registered as a Singleton (explicit exception to the Scoped-by-default DI rule) plus scoped IImageService / ImageUploadService."}], "edges": [{"source": "_github_copilot_instructions_mdmpi_app_solution", "target": "_github_copilot_instructions_clean_architecture", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": "Solution Overview", "weight": 1.0}, {"source": "_github_copilot_instructions_mdmpi_app_api", "target": "_github_copilot_instructions_mdmpi_app_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/copilot-instructions.md", "source_location": "Architecture Rules #1: Api -> Core", "weight": 1.0}, {"source": "_githu